rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    function isValidProject(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.description is string &&
             data.description.size() <= 500 &&
             data.initialPrompt is string &&
             data.initialPrompt.size() <= 2000 &&
             data.templateType is string &&
             data.templateType in ['web_app', 'dashboard', 'landing_page', 'utility'] &&
             data.isStarred is bool &&
             data.version is int &&
             data.version >= 1 &&
             data.htmlCode is string &&
             data.htmlCode.size() <= 250000 &&
             data.cssCode is string &&
             data.cssCode.size() <= 150000 &&
             data.jsCode is string &&
             data.jsCode.size() <= 200000;
    }

    function isValidChatMessage(data, userId, projectId) {
      return data.userId is string &&
             data.userId == userId &&
             data.projectId is string &&
             data.projectId == projectId &&
             data.role is string &&
             data.role in ['user', 'assistant'] &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 10000 &&
             data.filesChanged is list &&
             data.filesChanged.size() <= 10 &&
             (data.filesChanged.size() == 0 || data.filesChanged[0] is string) &&
             data.versionTag is int &&
             data.versionTag >= 0;
    }

    // --- Collection Rules ---
    match /users/{userId}/projects/{projectId} {
      allow get: if isOwner(userId) && isValidId(projectId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(projectId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'initialPrompt',
                         'templateType', 'isStarred', 'version',
                         'htmlCode', 'cssCode', 'jsCode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'initialPrompt',
                         'templateType', 'isStarred', 'version',
                         'htmlCode', 'cssCode', 'jsCode', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidProject(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(projectId) &&
                       isValidProject(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().initialPrompt == existing().initialPrompt &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       (
                         // Action 1: Metadata / star / rename update
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'isStarred', 'updatedAt']) ||
                         // Action 2: Code / AI iteration update
                         (
                           incoming().version >= existing().version &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'description', 'templateType', 'version',
                             'htmlCode', 'cssCode', 'jsCode', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isOwner(userId) && isValidId(projectId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(projectId) && isValidId(messageId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(projectId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll([
                           'userId', 'projectId', 'role', 'content',
                           'filesChanged', 'versionTag', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'projectId', 'role', 'content',
                           'filesChanged', 'versionTag', 'createdAt'
                         ]) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidChatMessage(incoming(), userId, projectId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/projects/$(projectId));

        // Append-only message history; users may delete messages when deleting a project
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(projectId) && isValidId(messageId);
      }
    }
  }
}
