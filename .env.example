# Zuno AI Server Environment Variables (keep on Vercel / server only — never expose to browsers)
GEMINI_API_KEY=
# Optional comma/newline-separated fallback keys:
GEMINI_API_KEYS=
# Optional private website/3D design intelligence. Set the full prompt only in Vercel server Environment Variables.
# It is applied server-side to Build and 3D requests and is never returned by the API.
ZUNO_DESIGN_INTELLIGENCE_PROMPT=
# Required to unlock Owner Admin Control (/admin):
ZUNO_ADMIN_PASSWORD=
# Optional: allow Admin Control (/admin) on Vercel to persist pasted keys permanently into Vercel Env Vars
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional alternative: Upstash / Vercel KV persistence (encrypted AES-256-GCM at rest)
KV_REST_API_URL=
KV_REST_API_TOKEN=
